# Local env for the gateway (copy to .env; .env is git-ignored). Loaded by spring.config.import in application.yml;
# real OS environment variables override these values.
PROFILE_ACTIVE=local
SERVER_PORT=8088

# Must match the Firebase project the frontend logs in to (VITE_FIREBASE_PROJECT_ID).
FIREBASE_PROJECT_ID=your-firebase-project-id

# Discovery server (Jobbeacon-discovery). Routes resolve lb://jobbeacon-be and lb://jobbeacon-recommendation
# through it, so backend and recommendation must be running and registered there.
EUREKA_URL=http://localhost:8761/eureka/

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
